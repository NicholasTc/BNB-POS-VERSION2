# Local Compose credentials only. Never reuse these outside loopback development.
DATABASE_URL=postgresql://lisi_dev:lisi_local_dev@127.0.0.1:55438/lisi_dev
TEST_DATABASE_URL=postgresql://lisi_test:lisi_local_test@127.0.0.1:55439/lisi_test
BETTER_AUTH_URL=http://127.0.0.1:3000
# Generate separate random secrets: openssl rand -base64 48
BETTER_AUTH_SECRET=
PIN_PEPPER=

# Optional Sheets module. Off by default; credentials stay server-only.
SHEETS_SYNC_MODE=off
SHEETS_SPREADSHEET_ID=
