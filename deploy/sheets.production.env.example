# Non-secret Railway worker settings. Paste these into the worker's Variables.
# This is a separate service; it does not replace the web app start command.
SHEETS_SYNC_MODE=live
SHEETS_SPREADSHEET_ID=1Pmv5xiEUWUmG1VnI1dRkqDZoP96APAgPsVLYYRvh_GU
SHEETS_LIVE_CONFIRMED=true
# The TS worker needs the pinned tsx dependency available at runtime.
RAILPACK_PRUNE_DEPS=false

# Add separately in Railway; never commit actual values:
# DATABASE_URL = reference the EXISTING production Postgres service's DATABASE_URL
# BETTER_AUTH_URL = the production web app HTTPS origin
# BETTER_AUTH_SECRET and PIN_PEPPER = references to existing production secrets
# GOOGLE_SERVICE_ACCOUNT_JSON = the service-account JSON as a private server variable
# Leave GOOGLE_SERVICE_ACCOUNT_FILE unset on Railway.
# Worker start command: npm run sheets:worker
# Use the tested repository revision and apply database migrations first.
# Do not create another production database or point this worker at localhost.
