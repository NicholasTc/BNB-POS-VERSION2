{
  "name": "lisi-pos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "owner:bootstrap": "tsx scripts/owner.ts",
    "gate": "npm run typecheck && npm run lint && npm test && npm run test:integration && npm run db:generate && npm run build && npm run check:secrets && npm run test:e2e && npm run backup:verify",
    "backup:dev": "node scripts/backup.mjs",
    "backup:verify": "node scripts/verify-backup.mjs",
    "check:secrets": "node scripts/check-client-secrets.mjs",
    "sheets:worker": "tsx scripts/sheets-worker.ts"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "better-auth": "1.7.10",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "zod": "4.6.7",
    "@next/env": "16.4.2",
    "google-auth-library": "11.3.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.18.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/pg": "8.15.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "vitest": "5.0.5",
    "@playwright/test": "1.64.1"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
